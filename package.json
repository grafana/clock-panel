{
  "name": "clock-panel",
  "version": "3.2.4",
  "description": "Clock Panel Plugin for Grafana",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e": "playwright test",
    "format": "prettier --write ./src",
    "i18n-extract": "i18next-cli extract --sync-primary",
    "i18n-extract:ci": "i18next-cli extract --sync-primary --dry-run --ci",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "playwright:test": "npx playwright test",
    "playwright:test:ui": "npx playwright test --ui",
    "playwright:showreport": "npx playwright show-report",
    "server": "docker compose up --build",
    "spellcheck": "cspell -c cspell.config.json \"**/*.{ts,tsx,js,go,md,mdx,yml,yaml,json,scss,css}\"",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "sign": "sign-plugin"
  },
  "keywords": [
    "clock",
    "grafana",
    "plugin",
    "panel"
  ],
  "author": "Grafana Labs",
  "license": "MIT",
  "devDependencies": {
    "@grafana/eslint-config": "10.0.0",
    "@grafana/eslint-plugin-plugins": "0.7.0",
    "@grafana/plugin-e2e": "3.11.0",
    "@grafana/sign-plugin": "3.3.3",
    "@grafana/tsconfig": "2.2.0",
    "@playwright/test": "1.62.1",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@swc/core": "1.15.47",
    "@swc/helpers": "0.5.23",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.3",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@types/semver": "7.8.0",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "copy-webpack-plugin": "14.0.0",
    "cspell": "10.0.1",
    "css-loader": "7.1.4",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "63.3.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-webpack-plugin": "6.0.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "glob": "13.0.6",
    "i18next-cli": "1.67.7",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "5.0.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "moment": "2.30.1",
    "prettier": "3.9.6",
    "replace-in-file-webpack-plugin": "1.0.6",
    "sass": "1.102.0",
    "sass-loader": "17.0.0",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "5.6.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "12.2.10",
    "@grafana/i18n": "12.4.0-21947912385",
    "@grafana/runtime": "12.2.10",
    "@grafana/schema": "12.2.10",
    "@grafana/ui": "12.2.10",
    "moment-timezone": "0.6.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.8.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "moment": "2.30.1"
  }
}
